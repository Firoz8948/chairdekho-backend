# ---------- App ----------
APP_NAME=ChairDekho
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
# Optional. If empty, PayU callbacks use https://api.chairdekho.com + API_V1_PREFIX
# when FRONTEND_URL is a chairdekho.com domain.
# API_PUBLIC_URL=https://api.chairdekho.com/api/v1
API_PUBLIC_URL=
# Extra allowed browser origins (comma-separated)
# CORS_ORIGINS=https://chairdekho.com,https://www.chairdekho.com

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chairdekho
# One-time setup only (postgres superuser password for scripts/setup_db.py)
# POSTGRES_ADMIN_PASSWORD=

# ---------- JWT ----------
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- OTP (Renflair SMS) ----------
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=4
OTP_DEBUG=false

# ---------- Renflair SMS ----------
# OTP (customer): https://sms.renflair.in/V1.php?API=&PHONE=&OTP=
# Order success (customer): https://sms.renflair.in/V3.php?API=&PHONE=&OID=&CNAME=
# New order (admin profile phone): https://sms.renflair.in/V4.php?API=&PHONE=&OID=
RENFLAIR_API_KEY=

# ---------- Twilio (legacy — unused) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Admin seed ----------
ADMIN_EMAIL=admin@chairdekho.com
ADMIN_PASSWORD=Admin@12345
BRAND_NAME=ChairDekho
ADMIN_NOTIFY_PHONE=9699164131
ADMIN_NOTIFY_EMAIL=brjangu29@gmail.com

# ---------- Razorpay (legacy fallback) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- PayU Biz (preferred online payments) ----------
PAYU_KEY=
PAYU_SALT=
# live | test
PAYU_MODE=live

# ---------- Media storage ----------
# auto = BunnyCDN when fully configured below, otherwise local disk
STORAGE_BACKEND=auto
# Local upload directory (relative paths resolve against the backend root)
UPLOAD_DIR=uploads

# ---------- BunnyCDN Storage (optional) ----------
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=sg
BUNNY_CDN_URL=

# ---------- Meta / Facebook Ads ----------
# Pixel ID from Events Manager → Data Sources → Pixel
META_PIXEL_ID=
# System User access token with ads_management / catalog permissions
META_ACCESS_TOKEN=
# Optional: Events Manager → Test Events code (for staging)
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

# ---------- Google reviews (Places API (New)) ----------
# Google Cloud Console → enable "Places API (New)" → Credentials → API key
# (restrict the key to Places API (New); billing must be enabled on the project)
GOOGLE_PLACES_API_KEY=
# Optional. Leave empty to look the business up once by GOOGLE_PLACE_QUERY
GOOGLE_PLACE_ID=
# GOOGLE_PLACE_QUERY=Chairdekho, Umadevi Mandir, Bolinj Road, Nalasopara West, Vasai-Virar
# Google Business Profile → "Ask for reviews" → copy link (e.g. https://g.page/r/XXXX/review)
GOOGLE_REVIEW_URL=
# How long fetched reviews are reused before asking Google again
GOOGLE_REVIEWS_CACHE_HOURS=12

# API user: Shiprocket dashboard → Settings → API → Create API User (email + password)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# Must match pickup location nickname (Settings → Pickup Addresses), often "Primary"
# Must match pickup nickname in Shiprocket exactly (Settings → Pickup Address)
SHIPROCKET_PICKUP_LOCATION=work
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_COURIER_ID=
# Push every new order to Shiprocket automatically
SHIPROCKET_AUTO_PUSH=true
# Set true only after courier is activated / wallet funded
SHIPROCKET_AUTO_AWB=false
SHIPROCKET_DEFAULT_LENGTH=10
SHIPROCKET_DEFAULT_BREADTH=10
SHIPROCKET_DEFAULT_HEIGHT=10

# ---------- Shipmozo ----------
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
# From Shipmozo panel → Warehouses (or Get Warehouses API)
SHIPMOZO_WAREHOUSE_ID=
# After push-order, call auto-assign-order for AWB
SHIPMOZO_AUTO_ASSIGN=true
SHIPMOZO_DEFAULT_LENGTH=10
SHIPMOZO_DEFAULT_BREADTH=10
SHIPMOZO_DEFAULT_HEIGHT=10
